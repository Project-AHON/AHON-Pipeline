{
  "datasets": [
    {
      "name": "9e49f5c3",
      "displayName": "pipeline_runs",
      "queryLines": [
        "SELECT\r\n",
        "  job_name, batch_id, job_run_id, started_at, ended_at,\r\n",
        "  round(duration_seconds / 60, 1) AS duration_min,\r\n",
        "  coalesce(result_state, 'RUNNING') AS result_state, termination_code,\r\n",
        "  tasks_total, tasks_succeeded, tasks_failed, tasks_skipped, tasks_blocked, tasks_cancelled, tasks_running,\r\n",
        "  dq_pass, dq_warn, dq_blocked, dq_error\r\n",
        "FROM monitoring.run_log\r\n",
        "WHERE job_name LIKE '%ahon_pipeline'"
      ]
    },
    {
      "name": "91aae6aa",
      "displayName": "pipeline_tasks",
      "queryLines": [
        "SELECT\r\n",
        "  job_run_id, batch_id, task_key, started_at, ended_at,\r\n",
        "  round(duration_seconds / 60, 1) AS duration_min,\r\n",
        "  coalesce(result_state, 'RUNNING') AS result_state, termination_code, attempts\r\n",
        "FROM monitoring.task_run_log\r\n",
        "WHERE job_name LIKE '%ahon_pipeline'"
      ]
    },
    {
      "name": "582aa39b",
      "displayName": "pipeline_last_run",
      "queryLines": [
        "SELECT\r\n",
        "  result_state                      AS last_status,\r\n",
        "  ended_at                          AS last_run_at,\r\n",
        "  round(duration_seconds / 60, 1)   AS last_duration_min,\r\n",
        "  tasks_failed                      AS last_tasks_failed,\r\n",
        "  round(timestampdiff(MINUTE, ended_at, current_timestamp()) / 60, 1) AS hours_since_last_run,\r\n",
        "  date_format(ended_at, 'MMM d, yyyy h:mm a') AS last_run_date\r\n",
        "FROM monitoring.run_log\r\n",
        "WHERE job_name LIKE '%ahon_pipeline'\r\n",
        "  AND ended_at IS NOT NULL\r\n",
        "ORDER BY ended_at DESC\r\n",
        "LIMIT 1"
      ]
    }
  ],
