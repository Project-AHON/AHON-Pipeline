{
  "datasets": [
    {
      "name": "52d59c22",
      "displayName": "dq_kpis",
      "queryLines": [
        "SELECT\r\n",
        "  count(*) AS checks,\r\n",
        "  count_if(status = 'PASS') AS passed,\r\n",
        "  round(100 * count_if(status = 'PASS') / count(*), 1) AS pass_rate_pct,\r\n",
        "  count_if(status <> 'PASS') AS failed_checks,\r\n",
        "  count_if(is_critical) AS critical_failures,\r\n",
        "  CASE WHEN count_if(is_critical) > 0 THEN 'STOP: fix before using the data'\r\n",
        "       ELSE 'OK: no stop rule failed' END AS stop_status,\r\n",
        "  count(DISTINCT CASE WHEN status <> 'PASS' THEN dataset END) AS datasets_affected,\r\n",
        "  count(DISTINCT dataset) AS datasets_checked,\r\n",
        "  max(checked_at) AS last_checked,\r\n",
        "  round((unix_timestamp(current_timestamp()) - unix_timestamp(max(checked_at))) / 3600, 1) AS hours_since_last_check\r\n",
        "FROM monitoring.dq_check_status;"
      ]
    },
    {
      "name": "d8ca9dc2",
      "displayName": "dq_by_dataset",
      "queryLines": [
        "SELECT dataset, status, count(*) AS checks, max(owner) AS owner\r\n",
        "FROM monitoring.dq_check_status\r\n",
        "GROUP BY dataset, status;"
      ]
    },
    {
      "name": "b53f8e93",
      "displayName": "dq_by_check_type",
      "queryLines": [
        "SELECT dataset, check_type,\r\n",
        "       count(*) AS checks,\r\n",
        "       count_if(status <> 'PASS') AS failed_checks\r\n",
        "FROM monitoring.dq_check_status\r\n",
        "GROUP BY dataset, check_type;"
      ]
    },
    {
      "name": "182da901",
      "displayName": "dq_failed_checks",
      "queryLines": [
        "SELECT\r\n",
        "  CASE WHEN is_critical THEN 'Critical' ELSE 'Warning' END AS level,\r\n",
        "  dataset, layer, table_name, check_id, check_type, status,\r\n",
        "  failed_count, failed_pct, owner, checked_at\r\n",
        "FROM monitoring.dq_check_status\r\n",
        "WHERE status <> 'PASS'\r\n",
        "ORDER BY is_critical DESC, failed_count DESC;"
      ]
    },
    {
      "name": "e64d7387",
      "displayName": "dq_check_detail",
      "queryLines": [
        "SELECT\r\n",
        "  dataset, layer, table_name, check_stage, check_type, check_id, status, severity,\r\n",
        "  coalesce(action, CASE severity WHEN 'ERROR' THEN 'stop' ELSE 'report' END) AS action,\r\n",
        "  failed_count, rows_checked, failed_pct,\r\n",
        "  coalesce(sample_keys, CASE WHEN check_stage = 'Build check' THEN 'count only (build check)' END) AS sample_keys,\r\n",
        "  coalesce(message, '') AS message,\r\n",
        "  owner, run_id, checked_at\r\n",
        "FROM monitoring.dq_check_status;"
      ]
    },
    {
      "name": "98c52031",
      "displayName": "dq_trend",
      "queryLines": [
        "SELECT\r\n",
        "  date(checked_at) AS check_date,\r\n",
        "  count(*) AS checks,\r\n",
        "  round(100 * count_if(status = 'PASS') / count(*), 1) AS pass_rate_pct,\r\n",
        "  count_if(is_critical) AS critical_failures\r\n",
        "FROM monitoring.dq_check_result\r\n",
        "GROUP BY date(checked_at)\r\n",
        "ORDER BY check_date;"
      ]
    }
  ],
