{
  "datasets": [
    {
      "name": "ds_population",
      "displayName": "Reported population",
      "queryLines": [
        "SELECT psgc_code, area_name, geographic_level, population_year, population, coverage_status, disposition, source_period\n",
        "FROM population_components\n",
        "ORDER BY population_year, psgc_code"
      ]
    },
    {
      "name": "ds_funding",
      "displayName": "Funding reports",
      "queryLines": [
        "SELECT psgc_code, reference_area_name, lgu_name, lgu_type, fiscal_year, source_period, appropriation_70_pct, expenditure_70_pct, total_appropriation, total_expenditure, utilization_rate_70_pct, utilization_rate_total, match_status, has_dq_issues\n",
        "FROM funding_components\n",
        "ORDER BY fiscal_year, lgu_name"
      ]
    },
    {
      "name": "ds_cmci",
      "displayName": "CMCI data coverage",
      "queryLines": [
        "SELECT psgc_code, year, pillar_name, source_period, expected_indicator_count, available_indicator_count, coverage_status, metric_version\n",
        "FROM cmci_pillar_coverage\n",
        "ORDER BY year, psgc_code, pillar_name"
      ]
    },
    {
      "name": "ds_earthquakes",
      "displayName": "Earthquake observations",
      "queryLines": [
        "SELECT source_year, source_month, source_period, source_observations, invalid_observations, single_textual_candidates, ambiguous_textual_candidates, unresolved_textual_candidates, maximum_reported_magnitude\n",
        "FROM earthquake_observation_summary\n",
        "ORDER BY source_year, source_month, source_period"
      ]
    }
  ],
  "pages": [
